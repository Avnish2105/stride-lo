#!/usr/bin/env python3
"""run_fg CMD [ARGS...]: exec CMD with SIGINT at its default disposition.

A process started in the background by a non-interactive shell (the launcher's commands, `&` in
scripts) begins with SIGINT ignored, and Python programs keep it ignored: `ros2 launch` and
`ros2 bag record` then never see the SIGINT that should shut them down in order (on SIGTERM,
ros2 launch exits at once and orphans its nodes). Used by stride_launcher.py for everything it
starts, so scripts/stop_all.sh can stop launches with SIGINT.
"""
import os
import signal
import sys

if len(sys.argv) < 2:
    sys.exit(__doc__)
signal.signal(signal.SIGINT, signal.SIG_DFL)
os.execvp(sys.argv[1], sys.argv[1:])
