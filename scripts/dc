#!/usr/bin/env bash
# docker compose wrapper for STRIDE (run from the host).
#   scripts/dc build dev                      build the dev image (ci: scripts/dc build ci)
#   scripts/dc run --rm dev scripts/build.sh  any command inside the container
#   scripts/dc run --rm dev bash              interactive shell
# The repo is mounted at its own absolute host path; bags from STRIDE_BAGS_DIR (read-only)
# appear at /data/bags. Default bags dir: the GPS-denied repo's rosbags/ if present, else ./data.
set -euo pipefail
# Already inside the dev container (e.g. the VS Code devcontainer) with no docker CLI:
# `run [opts] <service> cmd...` executes cmd directly; anything else is a no-op/error.
if [[ -f /.dockerenv ]] && ! command -v docker >/dev/null 2>&1; then
  if [[ "${1:-}" == run ]]; then
    shift
    while [[ "${1:-}" == -* ]]; do shift; done   # drop --rm etc. (no value-taking flags used)
    shift || true                                # drop the service name (dev|ci)
    [[ $# -gt 0 ]] || set -- bash
    exec "$@"
  elif [[ "${1:-}" == build ]]; then
    echo "scripts/dc: inside the dev container already; image build skipped (run it on the host)." >&2
    exit 0
  fi
  echo "scripts/dc: no docker CLI inside the container; run 'scripts/dc $*' on the host." >&2
  exit 1
fi
ws="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export STRIDE_WS="$ws"
export STRIDE_UID="${STRIDE_UID:-$(id -u)}"
export STRIDE_GID="${STRIDE_GID:-$(id -g)}"
if [[ -z "${STRIDE_BAGS_DIR:-}" ]]; then
  if [[ -d "$HOME/GPS-denied_State_estimation_Qudrapad/rosbags" ]]; then
    export STRIDE_BAGS_DIR="$HOME/GPS-denied_State_estimation_Qudrapad/rosbags"
  else
    export STRIDE_BAGS_DIR="$ws/data"
  fi
fi
mkdir -p "$ws/data" "$ws/.ccache"
exec docker compose -f "$ws/docker/compose.yml" "$@"
