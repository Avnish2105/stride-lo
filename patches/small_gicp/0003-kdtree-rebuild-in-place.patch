+  /// @brief Constructor without building (STRIDE patch 0003). Call rebuild() once `points` is
+  ///        filled; `points` must outlive the tree (it is held by reference).
+  UnsafeKdTree(const PointCloud& points, DeferredBuild) : points(points), root(INVALID_NODE) {}
+
+  /// @brief Rebuild the tree in place for the current contents of `points` (STRIDE patch 0003).
+  /// @note  `indices` and `nodes` keep their capacity, so once they have reached the largest
+  ///        cloud size this never allocates. Use the serial KdTreeBuilder for a deterministic
+  ///        node layout.
+  /// @note  Both vectors are cleared first: the builders do not reset `left`/`right` of leaf
+  ///        nodes, so reusing old elements would leave stale child links (wrong neighbours,
+  ///        possible cycles). clear() + the builder's resize() value-initialises every node
+  ///        without reallocating.
+  template <typename Builder = KdTreeBuilder>
+  void rebuild(const Builder& builder = Builder()) {
+    indices.clear();
+    nodes.clear();
+    root = INVALID_NODE;
+    if (traits::size(points) == 0) {
+      return;
+    }
+    builder.build_tree(*this, points);
+  }
