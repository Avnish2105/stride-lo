Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Odometry
      Name: LO odometry (debug, never fused)
      Enabled: true
      Topic:
        Value: /stride_lo/odometry
      Keep: 500
      Shape:
        Value: Axes
        Axes Length: 0.3
        Axes Radius: 0.03
    - Class: rviz_default_plugins/PointCloud2
      Name: Local map
      Enabled: true
      Topic:
        Value: /stride_lo/local_map
        Durability Policy: Transient Local
      Size (m): 0.05
      Color Transformer: AxisColor
    - Class: rviz_default_plugins/PointCloud2
      Name: Deskewed scan
      Enabled: false
      Topic:
        Value: /stride_lo/deskewed
      Size (m): 0.03
  Global Options:
    Fixed Frame: stride_odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
Window Geometry:
  Width: 1400
  Height: 900
