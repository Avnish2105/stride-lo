<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lo_ros</name>
  <version>0.1.0</version>
  <description>STRIDE LiDAR odometry ROS 2 layer: lifecycle (composable) node around lo_core, lifecycle supervisor, conversions, diagnostics, black box, launch files and robot configs.</description>
  <maintainer email="avnishd2105@gmail.com">avnish</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>lo_core</depend>
  <depend>lo_msgs</depend>
  <depend>livox_ros_driver2</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_components</depend>
  <depend>lifecycle_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>urdf</depend>
  <depend>rosbag2_cpp</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
